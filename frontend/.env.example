# WeAre Creators — frontend environment
# Copy to frontend/.env. Never commit the real .env.

# Where the API lives. Baked in at build time, so a production build must be
# rebuilt after changing this — it is not read at runtime.
# The frontend appends /api itself, so give the bare origin.
REACT_APP_BACKEND_URL=http://localhost:8001

# --- Parent brand -----------------------------------------------------------
# WeAre Creators is an offering of WeAre Studios and shares the studio's site.
# The endorsement line ("A WeAre Studios offering") sits beside the nav logo
# and in the home-page footer. It renders either way; set the URL to make it a
# link, leave it blank and it stays plain text rather than going nowhere.
REACT_APP_STUDIO_URL=
# Only if the studio is ever renamed. Defaults to "WeAre Studios".
REACT_APP_STUDIO_NAME=
