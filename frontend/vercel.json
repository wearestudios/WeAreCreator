{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/c/:id",
      "destination": "/index.html"
    },
    {
      "source": "/brands/:id",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/index.html"
    },
    {
      "source": "/work",
      "destination": "/index.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/creators/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/creators-in/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
