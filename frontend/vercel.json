{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/c/:id",
      "destination": "/index.html"
    },
    {
      "source": "/brands/:id",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/index.html"
    },
    {
      "source": "/work",
      "destination": "/index.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/influencer-marketing/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/survey",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
