# WeAre Creators — backend environment
# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------

MONGO_URL=mongodb://localhost:27017
DB_NAME=wearecreators

# Signs the auth cookies. Any long random string; changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000

# --- Admin account ----------------------------------------------------------
# Seeded on first boot only. If the account already exists the stored password
# wins and these are ignored — a password rotated in the product is not
# reverted by a deploy.

ADMIN_EMAIL=creators@example.com
ADMIN_PASSWORD=set-a-strong-password
ADMIN_NAME=WeAre Admin

# Set to true for ONE boot to overwrite an existing admin password, then remove.
# ADMIN_PASSWORD_RESET=false

# --- WhatsApp OTP (AiSensy) -------------------------------------------------
# Creators and brands sign in with a WhatsApp code. Without these credentials
# the server REFUSES to issue codes unless simulation is explicitly permitted.

AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=

# Simulation writes the login code to the server log instead of sending it.
# Fine on a laptop or a preview environment, NEVER in production.
# Also enabled automatically when APP_ENV is dev/development/local/test.
ALLOW_OTP_SIMULATION=true

# dev | development | local | test marks this as a non-production machine: it
# permits OTP simulation and silences the boot warnings about a missing admin
# account and CORS. Anything else — including blank — is treated as production.
# ENV is read as a fallback when APP_ENV is unset, because some hosts set that
# name instead; APP_ENV wins where both are present.
APP_ENV=development
# ENV=

# OTP tuning (defaults shown)
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_HOURLY_LIMIT=5
# OTP_MAX_ATTEMPTS=5

# LOCAL AND STAGING ONLY. Issues this fixed 6-digit code for every OTP instead
# of a random one, so testing signup doesn't mean reading a code out of the
# server log each time. It is a login bypass for anyone who knows a phone
# number, so it is refused unless simulation is permitted, APP_ENV is not
# production, and no AiSensy credentials are set — and the server logs a
# warning at boot and on every code it issues. Never set this in production.
# Only the value changes: the TTL, resend cooldown, hourly limit and attempt
# lockout all still apply, so those paths stay testable.
# OTP_TEST_CODE=123456

# --- Parent brand -----------------------------------------------------------
# The parent brand is credited in the footer and beside the navbar wordmark,
# both of which the React app renders — so the variables are
# REACT_APP_STUDIO_NAME / REACT_APP_STUDIO_URL in the *frontend* build, not
# here. The backend used to render two marketing pages of its own and read
# STUDIO_NAME/STUDIO_URL for their footers; those pages are React routes now.
# With no URL the endorsement still renders, as plain text rather than a link
# that goes nowhere. See PREVIEW.md.

# --- Notifications ----------------------------------------------------------
# One AiSensy template per event, named AISENSY_TEMPLATE_<EVENT> and looked up
# by the event name in upper case. Every event in NOTIFY_EVENTS is listed below
# — a unit test fails if the two drift apart, so this is the full set rather
# than a sample.
#
# An event with no template is still recorded and readable in-app; it just
# isn't pushed to WhatsApp. That is a supported state: configure the handful
# that matter to your operation and leave the rest blank.

# To the creator, about their own application
# AISENSY_TEMPLATE_APPLICATION_ACCEPTED=
# AISENSY_TEMPLATE_APPLICATION_DECLINED=
# AISENSY_TEMPLATE_COMMERCIAL_AGREED=
# AISENSY_TEMPLATE_SLOT_BOOKED=
# AISENSY_TEMPLATE_SLOT_CONFIRMED=
# AISENSY_TEMPLATE_CONTENT_CHANGES_REQUESTED=
# AISENSY_TEMPLATE_CONTENT_APPROVED=
# AISENSY_TEMPLATE_PAYMENT_SENT=
# AISENSY_TEMPLATE_QUESTION_ANSWERED=
# The two outcomes of draft review. CHANGES_REQUESTED carries the reviewer's
# note, which is the whole message — a send-back with no reason is a round
# trip wasted.
# AISENSY_TEMPLATE_DRAFT_APPROVED=
# AISENSY_TEMPLATE_DRAFT_CHANGES_REQUESTED=

# To the creator, about their account
# AISENSY_TEMPLATE_CREATOR_VERIFIED=
# AISENSY_TEMPLATE_CREATOR_REJECTED=
# AISENSY_TEMPLATE_CREATOR_SUSPENDED=
# AISENSY_TEMPLATE_CREATOR_REINSTATED=
# AISENSY_TEMPLATE_PROFILE_SUBMITTED=
# AISENSY_TEMPLATE_INSTAGRAM_DISCONNECTED=
# AISENSY_TEMPLATE_PROFILE_NUDGE=  # params: name, percent complete, what's missing

# To the brand manager, about their own campaigns. A brand runs its campaigns
# from a phone between other work, so anything that changes what they have to
# do next reaches them rather than waiting to be found on a dashboard.
# AISENSY_TEMPLATE_NEW_APPLICANT=
# AISENSY_TEMPLATE_BRAND_NEW_APPLICATION=
# AISENSY_TEMPLATE_BRAND_SLOT_BOOKED=
# AISENSY_TEMPLATE_BRAND_SLOT_CANCELLED=
# AISENSY_TEMPLATE_BRAND_SLOT_RESCHEDULED=
# AISENSY_TEMPLATE_BRAND_CONTENT_SUBMITTED=
# AISENSY_TEMPLATE_BRAND_CREATOR_CANCELLED=
# AISENSY_TEMPLATE_BRAND_CREATOR_NO_SHOW=
# AISENSY_TEMPLATE_BRAND_VERIFICATION_SUBMITTED=
# A creator asked a question on a campaign. Goes to whoever runs it — the
# brand's manager on a brand-run campaign, the WeAre side otherwise.
# AISENSY_TEMPLATE_CAMPAIGN_QUESTION=
# A creator sent a draft for review. Routed the same way, for the same reason.
# AISENSY_TEMPLATE_DRAFT_SUBMITTED=

# To the WeAre campaign manager assigned to a brief
# AISENSY_TEMPLATE_MANAGER_ASSIGNED=
# AISENSY_TEMPLATE_MANAGER_SLOT_BOOKED=
# AISENSY_TEMPLATE_MANAGER_SLOT_RELEASED=

# These go out on the utility sender, which has its own simulation fallback,
# rather than through the notification path. Without a template (and without
# simulation) the decision still stands and is recorded in-app; the send is
# reported as failed rather than silently dropped.
#
# Params, in order:
#   CAMPAIGN_INVITE      campaign title, brand name, budget per creator
#   BRAND_VERIFIED       business name
#   BRAND_REJECTED       business name, reason
#   CAMPAIGN_APPROVED    campaign title, status (open|upcoming)
#   CAMPAIGN_REJECTED    campaign title, reason
#   CAMPAIGN_BROADCAST   campaign title, message
#   BRAND_CAMPAIGN_UPDATED  campaign title, what changed
# AISENSY_TEMPLATE_CAMPAIGN_INVITE=
# AISENSY_TEMPLATE_BRAND_VERIFIED=
# AISENSY_TEMPLATE_BRAND_REJECTED=
# AISENSY_TEMPLATE_CAMPAIGN_APPROVED=
# AISENSY_TEMPLATE_CAMPAIGN_REJECTED=
# AISENSY_TEMPLATE_CAMPAIGN_BROADCAST=
# AISENSY_TEMPLATE_BRAND_CAMPAIGN_UPDATED=

# --- Shareable brief links --------------------------------------------------
# The origin that /c/{id} share links are built from. Every campaign has a
# public page at that path, server-rendered so WhatsApp and Instagram can read
# its Open Graph tags — a preview crawler does not run JavaScript, so tags the
# React app injects are tags nobody ever sees.
#
# Defaults to the first entry in CORS_ORIGINS, which is the frontend, so links
# look like the product. Set this when the backend is on its own host and you
# have proxied /c/* to it (see PREVIEW.md) — or to the backend's own URL if you
# would rather share that directly.
# PUBLIC_SHARE_BASE_URL=https://wearecreators.in

# --- Pricing ----------------------------------------------------------------
# Margin charged to the brand on top of the creator's fee. The creator always
# receives 100% of the agreed amount.
PLATFORM_FEE_PERCENT=15

# --- Legal ------------------------------------------------------------------
# Stamped onto each account at signup. Bump when the terms change.
TERMS_VERSION=2026-08-13

# --- Uploads ----------------------------------------------------------------
# Where creator profile images land, and the per-file ceiling in megabytes.
# UPLOAD_DIR defaults to backend/uploads; MAX_UPLOAD_MB is clamped to 0.1–25.
UPLOAD_DIR=
MAX_UPLOAD_MB=5

# Brand verification documents — GST certificates, registration papers, FSSAI
# and shop-establishment licences. These are somebody's business paperwork, so
# they must NOT live under UPLOAD_DIR: that directory is mounted as static
# files and anything in it is fetchable by anyone who guesses the name. This
# one is never served directly; the only way out is
# GET /api/admin/brands/{user_id}/documents/{id}, which is admin-only and
# audited. Defaults to backend/private_uploads. Keep it off any web root, and
# back it up with the same care as the database.
PRIVATE_UPLOAD_DIR=

# --- Instagram: official stats ----------------------------------------------
# "Instagram API with Instagram Login" — deliberately not the Facebook-Login
# flow, which would require every creator to link a Facebook Page. Two read
# scopes only: instagram_business_basic and instagram_business_manage_insights.
#
# Leave these blank and the feature is simply off: the connect button renders
# in a clearly disabled state, the refresh jobs no-op, and follower counts stay
# self-reported. That is the correct state while the Meta app is in review.
#
# INSTAGRAM_REDIRECT_URI must match both the Meta app settings and the frontend
# route, which is /onboarding/creator/instagram.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# Fernet key encrypting access tokens at rest. Without it the feature stays off
# rather than storing tokens in the clear. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes stored tokens unreadable — creators are asked to reconnect,
# which is recoverable, but don't rotate casually.
INSTAGRAM_TOKEN_KEY=

# How long a cached reading counts as current. The ceiling is 200 calls per
# user per hour and a reading costs three, so this is never done on page load.
INSTAGRAM_STATS_TTL_HOURS=12

# How often the token-renewal and stats passes run. 0 disables the loop, for
# deployments driving POST /api/admin/jobs/instagram from their own scheduler.
INSTAGRAM_JOB_INTERVAL_SECONDS=1800

# --- Creator onboarding nudge -----------------------------------------------
# One WhatsApp chase, ever, to creators who signed up and left their profile
# unfinished. 0 on the interval disables the loop.
PROFILE_NUDGE_AFTER_DAYS=3
PROFILE_NUDGE_INTERVAL_SECONDS=3600
# AISENSY_TEMPLATE_PROFILE_NUDGE=  # params: name, percent complete, what's missing
