# WeAre Creators — backend environment
# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------

MONGO_URL=mongodb://localhost:27017
DB_NAME=wearecreators

# Signs the auth cookies. Any long random string; changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000

# --- Admin account ----------------------------------------------------------
# Seeded on first boot only. If the account already exists the stored password
# wins and these are ignored — a password rotated in the product is not
# reverted by a deploy.

ADMIN_EMAIL=creators@example.com
ADMIN_PASSWORD=set-a-strong-password
ADMIN_NAME=WeAre Admin

# Set to true for ONE boot to overwrite an existing admin password, then remove.
# ADMIN_PASSWORD_RESET=false

# --- WhatsApp OTP (AiSensy) -------------------------------------------------
# Creators and brands sign in with a WhatsApp code. Without these credentials
# the server REFUSES to issue codes unless simulation is explicitly permitted.

AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=

# Simulation writes the login code to the server log instead of sending it.
# Fine on a laptop or a preview environment, NEVER in production.
# Also enabled automatically when APP_ENV is dev/development/local/test.
ALLOW_OTP_SIMULATION=true
APP_ENV=development

# OTP tuning (defaults shown)
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_HOURLY_LIMIT=5
# OTP_MAX_ATTEMPTS=5

# --- Notifications ----------------------------------------------------------
# One AiSensy template per event. Events without a template are still recorded
# and visible in-app; they just aren't pushed to WhatsApp.
# Full list of events: NOTIFY_EVENTS in server.py

# AISENSY_TEMPLATE_APPLICATION_ACCEPTED=
# AISENSY_TEMPLATE_APPLICATION_DECLINED=
# AISENSY_TEMPLATE_COMMERCIAL_AGREED=
# AISENSY_TEMPLATE_SLOT_BOOKED=
# AISENSY_TEMPLATE_CONTENT_CHANGES_REQUESTED=
# AISENSY_TEMPLATE_CONTENT_APPROVED=
# AISENSY_TEMPLATE_PAYMENT_SENT=
# AISENSY_TEMPLATE_NEW_APPLICANT=
# AISENSY_TEMPLATE_CREATOR_VERIFIED=
# AISENSY_TEMPLATE_CREATOR_REJECTED=

# --- Pricing ----------------------------------------------------------------
# Margin charged to the brand on top of the creator's fee. The creator always
# receives 100% of the agreed amount.
PLATFORM_FEE_PERCENT=15

# --- Legal ------------------------------------------------------------------
# Stamped onto each account at signup. Bump when the terms change.
TERMS_VERSION=2026-08-13

# --- Uploads ----------------------------------------------------------------
# Where creator profile images land, and the per-file ceiling in megabytes.
# UPLOAD_DIR defaults to backend/uploads; MAX_UPLOAD_MB is clamped to 0.1–25.
UPLOAD_DIR=
MAX_UPLOAD_MB=5
